---
// Fila de un endpoint con botón para probarlo desde la propia página.
// La petición va a la ruta relativa: en local prueba el Worker local y en el deploy, el deploy.
interface Props {
  method: 'GET' | 'POST';
  path: string;
  origin: string;
  body?: unknown;
}

const { method, path, origin, body } = Astro.props;
const json = body === undefined ? '' : JSON.stringify(body, null, 2);
const rows = Math.min(json.split('\n').length, 18);
---

<div class="tester" data-tester data-method={method} data-path={path}>
  <div class="bar">
    <span class="method">{method}</span>
    <code class="url">{origin}{path}</code>
    <button type="button" class="run" data-run aria-label={`Probar ${method} ${path}`}>Probar <span aria-hidden="true">▸</span></button>
  </div>

  {
    body !== undefined && (
      <details class="body">
        <summary>Cuerpo de la petición (editable)</summary>
        <textarea data-body spellcheck="false" autocomplete="off" rows={rows} aria-label={`Cuerpo JSON de ${method} ${path}`}>{json}</textarea>
      </details>
    )
  }

  <div class="result" data-result hidden aria-live="polite">
    <div class="meta">
      <span class="status" data-status></span>
      <span class="muted" data-time></span>
    </div>
    <pre data-output></pre>
  </div>
</div>

<style>
  .tester {
    border-top: 1px solid var(--line);
    padding-block: 0.55rem;
  }

  .tester:last-of-type {
    border-bottom: 1px solid var(--line);
  }

  .bar {
    display: grid;
    grid-template-columns: 3.5rem 1fr auto;
    align-items: center;
    gap: 1rem;
  }

  .method {
    color: var(--accent);
    font-size: 0.87rem;
  }

  .url {
    overflow-wrap: anywhere;
  }

  .run {
    font: inherit;
    font-size: 0.82rem;
    color: var(--fg);
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 4px;
    padding: 0.3rem 0.75rem;
    cursor: pointer;
    white-space: nowrap;
  }

  .run:hover {
    border-color: var(--accent);
    color: var(--accent);
  }

  .run:disabled {
    cursor: progress;
    color: var(--muted);
    border-color: var(--line);
  }

  .body {
    margin: 0.5rem 0 0 4.5rem;
  }

  .body summary {
    cursor: pointer;
    color: var(--muted);
    font-size: 0.82rem;
  }

  .body summary:hover {
    color: var(--fg);
  }

  textarea {
    display: block;
    width: 100%;
    margin-top: 0.5rem;
    padding: 0.85rem 1rem;
    font: inherit;
    font-size: 0.82rem;
    line-height: 1.55;
    color: var(--fg);
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 6px;
    resize: vertical;
    tab-size: 2;
  }

  textarea:focus {
    border-color: var(--muted);
    outline: none;
  }

  .result {
    margin: 0.75rem 0 0.25rem 4.5rem;
  }

  .meta {
    display: flex;
    gap: 1rem;
    font-size: 0.82rem;
    margin-bottom: 0.4rem;
  }

  .status[data-ok='true'] {
    color: #3fdc6f;
  }

  .status[data-ok='false'] {
    color: var(--accent);
  }

  .result pre {
    max-height: 26rem;
    overflow: auto;
    font-size: 0.8rem;
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }

  @media (max-width: 640px) {
    .bar {
      grid-template-columns: auto 1fr;
    }

    .run {
      grid-column: 1 / -1;
      justify-self: start;
    }

    .body,
    .result {
      margin-left: 0;
    }
  }
</style>

<script>
  import { TOKEN_DEL_TALLER } from '../data/taller';

  function pretty(text: string): string {
    try {
      return JSON.stringify(JSON.parse(text), null, 2);
    } catch {
      return text;
    }
  }

  async function run(tester: HTMLElement) {
    const { method = 'GET', path = '' } = tester.dataset;
    const button = tester.querySelector<HTMLButtonElement>('[data-run]')!;
    const result = tester.querySelector<HTMLElement>('[data-result]')!;
    const status = tester.querySelector<HTMLElement>('[data-status]')!;
    const time = tester.querySelector<HTMLElement>('[data-time]')!;
    const output = tester.querySelector<HTMLElement>('[data-output]')!;
    const textarea = tester.querySelector<HTMLTextAreaElement>('[data-body]');

    result.hidden = false;
    status.textContent = '';
    status.removeAttribute('data-ok');
    time.textContent = '';

    let body: string | undefined;
    if (textarea) {
      try {
        body = JSON.stringify(JSON.parse(textarea.value));
      } catch {
        status.textContent = 'JSON no válido';
        status.dataset.ok = 'false';
        output.textContent = 'Revisa el cuerpo de la petición: no es JSON válido.';
        tester.querySelector('details')?.setAttribute('open', '');
        return;
      }
    }

    button.disabled = true;
    output.textContent = 'Enviando…';
    const start = performance.now();

    try {
      const response = await fetch(path, {
        method,
        headers: {
          Authorization: `Bearer ${TOKEN_DEL_TALLER}`,
          ...(body ? { 'Content-Type': 'application/json' } : {}),
        },
        body,
      });

      status.textContent = `${response.status} ${response.statusText}`.trim();
      status.dataset.ok = String(response.ok);

      // Se lee en streaming para que "stream": true se vea llegar en directo
      const reader = response.body?.getReader();
      const decoder = new TextDecoder();
      let text = '';
      output.textContent = '';
      if (reader) {
        for (;;) {
          const { done, value } = await reader.read();
          if (done) break;
          text += decoder.decode(value, { stream: true });
          output.textContent = text;
        }
      }
      text += decoder.decode();
      output.textContent = pretty(text) || '(respuesta vacía)';
    } catch (err) {
      status.textContent = 'Error de red';
      status.dataset.ok = 'false';
      output.textContent = err instanceof Error ? err.message : String(err);
    } finally {
      time.textContent = `${Math.round(performance.now() - start)} ms`;
      button.disabled = false;
    }
  }

  document.addEventListener('click', (event) => {
    const button = (event.target as Element).closest('[data-run]');
    const tester = button?.closest<HTMLElement>('[data-tester]');
    if (tester) run(tester);
  });
</script>
