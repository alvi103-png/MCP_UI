---
import { Code } from 'astro:components';
import ApiTester from '../components/ApiTester.astro';
import { TOKEN_DEL_TALLER } from '../data/taller';
import Base from '../layouts/Base.astro';

const theme = 'css-variables';

// Los ejemplos apuntan siempre al deploy, también en local
const origin = 'https://upskilling-mwc-taller.midudev.workers.dev';

const curlJev = `curl ${origin}/api/jev \\
  -H "Authorization: Bearer $TOKEN_DEL_TALLER" \\
  -H "Content-Type: application/json" \\
  -d '{
    "state": "El pedido llegó tarde y la caja estaba rota.",
    "questions": {
      "equipo":  { "type": "choice", "instructions": "¿Qué equipo debe atenderlo?",
                   "criteria": { "envios": "Retrasos y transporte", "devoluciones": null, "facturacion": null } },
      "enfado":  { "type": "score", "instructions": "¿Cómo de enfadado está el cliente?",
                   "criteria": ["Nada", "Algo molesto", "Muy enfadado"] },
      "urgente": { "type": "noul", "instructions": "¿Requiere respuesta hoy?" }
    }
  }'`;

const fetchJev = `const response = await fetch('${origin}/api/jev', {
  method: 'POST',
  headers: {
    Authorization: \`Bearer \${TOKEN_DEL_TALLER}\`,
    'Content-Type': 'application/json',
  },
  body: JSON.stringify({
    state: 'El pedido llegó tarde y la caja estaba rota.',
    questions: {
      equipo: {
        type: 'choice',
        instructions: '¿Qué equipo debe atenderlo?',
        criteria: { envios: 'Retrasos y transporte', devoluciones: null, facturacion: null },
      },
      urgente: { type: 'noul', instructions: '¿Requiere respuesta hoy?' },
    },
  }),
});

const { answers } = await response.json();

answers.equipo.choice;   // 'envios'
answers.urgente.noul;    // 0.87 → probabilidad de «sí»`;

const responseJev = `{
  "model": "jev-1.14.0",
  "answers": {
    "equipo":  { "type": "choice", "choice": "envios", "confidence": 0.97,
                 "probabilities": { "envios": 0.97, "devoluciones": 0.03, "facturacion": 0.0 } },
    "enfado":  { "type": "score", "score": 1.7, "confidence": 0.55,
                 "legend": { "0": "Nada", "1": "Algo molesto", "2": "Muy enfadado" },
                 "probabilities": { "0": 0.1, "1": 0.1, "2": 0.8 } },
    "urgente": { "type": "noul", "noul": 0.87 }
  },
  "usage": { "input_tokens": 328, "output_tokens": 34 }
}`;

const sdkJev = `// npm install @typesafe-ai/sdk
import { TypeSafeClient, choice, score, noul } from '@typesafe-ai/sdk';

const client = new TypeSafeClient({
  apiKey: process.env.TOKEN_DEL_TALLER,
  baseURL: '${origin}/api/jev',
});

const { answers } = await client.systemOne({
  state: { review: 'Llegó rápido, pero la talla es enorme.' },
  questions: {
    tema: choice('¿De qué habla la reseña?', { envio: null, talla: null, calidad: null }),
    nota: score('¿Qué valoración le pondrías?', ['Mala', 'Regular', 'Buena']),
    spam: noul('¿Es spam o publicidad?'),
  },
});

console.log(answers.tema.choice, answers.nota.score, answers.spam.noul);`;

const sdkOpenAI = `// npm install openai
import OpenAI from 'openai';

const openai = new OpenAI({
  apiKey: process.env.TOKEN_DEL_TALLER,
  baseURL: '${origin}/api/openai/v1',
});

const completion = await openai.chat.completions.create({
  model: 'gpt-6-luna',
  messages: [
    { role: 'system', content: 'Eres el asistente de una tienda online.' },
    { role: 'user', content: 'Recomiéndame un regalo por menos de 30 €.' },
  ],
});

console.log(completion.choices[0].message.content);`;

const fetchOpenAI = `const response = await fetch('${origin}/api/openai/v1/chat/completions', {
  method: 'POST',
  headers: {
    Authorization: \`Bearer \${TOKEN_DEL_TALLER}\`,
    'Content-Type': 'application/json',
  },
  body: JSON.stringify({
    model: 'gpt-6-luna',
    messages: [{ role: 'user', content: 'Di hola en una frase.' }],
  }),
});

const data = await response.json();
console.log(data.choices[0].message.content);`;

// Si se compila sin WORKSHOP_TOKEN en .dev.vars, los ejemplos muestran un marcador
const token = TOKEN_DEL_TALLER || 'TU_TOKEN';

const envExample = `# .env
TOKEN_DEL_TALLER=${token}`;

// Cuerpos de ejemplo de los botones «Probar» (editables en la página)
const bodyJev = {
  state: 'El pedido llegó tarde y la caja estaba rota.',
  questions: {
    equipo: {
      type: 'choice',
      instructions: '¿Qué equipo debe atenderlo?',
      criteria: { envios: 'Retrasos y transporte', devoluciones: null, facturacion: null },
    },
    enfado: {
      type: 'score',
      instructions: '¿Cómo de enfadado está el cliente?',
      criteria: ['Nada', 'Algo molesto', 'Muy enfadado'],
    },
    urgente: { type: 'noul', instructions: '¿Requiere respuesta hoy?' },
  },
};

const bodyChat = {
  model: 'gpt-6-luna',
  messages: [
    { role: 'system', content: 'Eres el asistente de una tienda online. Responde en una frase.' },
    { role: 'user', content: 'Recomiéndame un regalo por menos de 30 €.' },
  ],
};

const bodyResponses = {
  model: 'gpt-6-luna',
  input: 'Di hola en una frase.',
};
---

<Base title="APIs del taller" description="APIs de Jev y OpenAI ya configuradas para usar durante el taller.">
  <p class="label">Ya configuradas · sin registrarte en ningún sitio</p>
  <h1>APIs</h1>
  <p class="intro muted">
    Durante el taller tienes dos APIs listas para usar con un único token: <strong>Jev</strong> (decisiones
    estructuradas) y <strong>OpenAI</strong> (generación de texto). Cada endpoint tiene un
    botón <strong>Probar</strong> para ver la respuesta real sin escribir código. El token deja de funcionar al terminar la
    sesión.
  </p>

  <div class="token">
    <p class="label" id="token-label">Token del taller</p>
    {
      TOKEN_DEL_TALLER ? (
        <div class="token-row">
          <code>{TOKEN_DEL_TALLER}</code>
          <button type="button" data-copy={TOKEN_DEL_TALLER}>Copiar</button>
        </div>
      ) : (
        <p class="muted">Lo verás en la presentación del taller.</p>
      )
    }
  </div>

  <dl class="facts">
    <div>
      <dt>Autenticación</dt>
      <dd><code>Authorization: Bearer {token}</code></dd>
    </div>
    <div>
      <dt>Límite</dt>
      <dd>100 peticiones cada 10 s por red (la Wi-Fi del taller cuenta como una) · 256 KB por petición</dd>
    </div>
    <div>
      <dt>CORS</dt>
      <dd>Abierto: puedes llamarlas desde el navegador</dd>
    </div>
  </dl>

  <Code code={envExample} lang="bash" theme={theme} />

  <h2 id="jev"><span class="accent">01</span> Jev</h2>
  <p>
    Jev no genera texto: responde preguntas sobre un contenido (<code>state</code>) con datos que tu código usa
    directamente. Una sola llamada puede llevar varias preguntas.
  </p>

  <table>
    <thead>
      <tr><th>Tipo</th><th>Para qué</th><th>Respuesta</th></tr>
    </thead>
    <tbody>
      <tr>
        <td><code>choice</code></td>
        <td>Elegir una opción entre varias</td>
        <td><code>choice</code>, <code>confidence</code>, <code>probabilities</code></td>
      </tr>
      <tr>
        <td><code>score</code></td>
        <td>Puntuar en una escala ordenada (de 2 a 10 niveles)</td>
        <td><code>score</code> (media ponderada), <code>confidence</code></td>
      </tr>
      <tr>
        <td><code>noul</code></td>
        <td>Sí o no</td>
        <td><code>noul</code>: probabilidad de «sí», de 0 a 1</td>
      </tr>
    </tbody>
  </table>

  <div class="endpoints">
    <ApiTester method="POST" path="/api/jev" origin={origin} body={bodyJev} />
    <ApiTester method="GET" path="/api/jev/v1/models" origin={origin} />
  </div>

  <h3>Con fetch</h3>
  <Code code={fetchJev} lang="js" theme={theme} />

  <h3>Respuesta</h3>
  <Code code={responseJev} lang="json" theme={theme} />

  <h3>Con el SDK oficial</h3>
  <p>
    Cambia la <code>baseURL</code> y usa el token del taller como <code>apiKey</code>. En el navegador añade
    <code>dangerouslyAllowBrowser: true</code>.
  </p>
  <Code code={sdkJev} lang="js" theme={theme} />

  <h3>Con curl</h3>
  <Code code={curlJev} lang="bash" theme={theme} />

  <p class="muted">
    Si no indicas <code>model</code> se usa <code>jev-latest</code>. Documentación completa:
    <a href="https://docs.typesafe.ai">docs.typesafe.ai</a>.
  </p>

  <h2 id="openai"><span class="accent">02</span> OpenAI</h2>
  <p>
    Compatible con el SDK oficial de OpenAI: solo cambia la <code>baseURL</code>. Admite streaming. Modelo
    disponible: <code>gpt-6-luna</code> (se usa por defecto si no indicas ninguno).
  </p>

  <div class="endpoints">
    <ApiTester method="POST" path="/api/openai/v1/chat/completions" origin={origin} body={bodyChat} />
    <ApiTester method="POST" path="/api/openai/v1/responses" origin={origin} body={bodyResponses} />
    <ApiTester method="GET" path="/api/openai/v1/models" origin={origin} />
  </div>
  <p class="muted hint">Añade <code>"stream": true</code> al cuerpo para ver la respuesta llegar en directo.</p>

  <h3>Con el SDK oficial</h3>
  <Code code={sdkOpenAI} lang="js" theme={theme} />

  <h3>Con fetch</h3>
  <Code code={fetchOpenAI} lang="js" theme={theme} />

  <h2>Errores</h2>
  <table>
    <tbody>
      <tr><td><code>401</code></td><td>Falta el token del taller o no es válido</td></tr>
      <tr><td><code>400</code></td><td>JSON no válido o modelo no permitido</td></tr>
      <tr><td><code>413</code></td><td>La petición supera los 256 KB</td></tr>
      <tr><td><code>429</code></td><td>La red ha superado las 100 peticiones en 10 s (el límite se comparte con la sala): espera unos segundos</td></tr>
    </tbody>
  </table>
</Base>


<style>
  h1 {
    font-size: clamp(2.5rem, 7vw, 4rem);
    margin-block: 0.5rem 1.25rem;
  }

  .intro {
    max-width: 62ch;
    margin-bottom: 2.5rem;
  }

  .intro strong {
    color: var(--fg);
    font-weight: 500;
  }

  h2 {
    font-size: 2rem;
    margin-block: 4rem 1rem;
    padding-top: 2rem;
    border-top: 1px solid var(--line);
  }

  h3 {
    font-size: 1.15rem;
    margin-block: 2rem 0.75rem;
  }

  p {
    max-width: 68ch;
    margin-bottom: 1.1rem;
  }

  :global(pre) {
    margin-bottom: 1.25rem;
  }

  dl {
    margin: 0 0 1.5rem;
  }

  dl div {
    display: grid;
    grid-template-columns: 9rem 1fr;
    gap: 1rem;
    padding-block: 0.55rem;
    border-top: 1px solid var(--line);
  }

  dl div:last-child {
    border-bottom: 1px solid var(--line);
  }

  dt {
    color: var(--muted);
    font-size: 0.87rem;
  }

  dd {
    margin: 0;
    overflow-wrap: anywhere;
  }

  .token {
    margin-bottom: 2.5rem;
    padding: 1.1rem 1.25rem;
    border: 1px solid var(--accent);
    border-radius: 6px;
    background: var(--surface);
  }

  .token-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem 1.5rem;
    margin-top: 0.35rem;
  }

  .token code {
    font-family: var(--pixel);
    font-size: clamp(1.4rem, 5vw, 2.1rem);
    border: 0;
    padding: 0;
    background: none;
    overflow-wrap: anywhere;
  }

  .token button {
    font: inherit;
    font-size: 0.87rem;
    color: #fff;
    background: var(--accent);
    border: 1px solid var(--accent);
    border-radius: 4px;
    padding: 0.35rem 0.9rem;
    cursor: pointer;
  }

  .token button:hover {
    filter: brightness(1.1);
  }

  .endpoints {
    margin-bottom: 1.5rem;
  }

  .hint {
    font-size: 0.87rem;
  }

  table {
    width: 100%;
    border-collapse: collapse;
    margin-bottom: 1.5rem;
    font-size: 0.9rem;
  }

  th,
  td {
    text-align: left;
    padding: 0.55rem 0.75rem 0.55rem 0;
    border-bottom: 1px solid var(--line);
    vertical-align: top;
  }

  th {
    color: var(--muted);
    font-weight: 400;
  }
</style>

<script>
  for (const button of document.querySelectorAll<HTMLButtonElement>('[data-copy]')) {
    button.addEventListener('click', async () => {
      await navigator.clipboard.writeText(button.dataset.copy ?? '');
      button.textContent = 'Copiado';
      setTimeout(() => (button.textContent = 'Copiar'), 1500);
    });
  }
</script>
