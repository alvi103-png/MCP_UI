---
import BackLink from '../../components/directo/BackLink.astro';
import Directo from '../../layouts/Directo.astro';
import WhisperTranslator from '../../components/directo/WhisperTranslator';
---

<Directo title="Traductor · Whisper en local" description="Whisper transcribe en el navegador con WebGPU y traduce en tiempo real con la API Translator de Chrome o, en cualquier navegador, con los modelos de Firefox">
  <div class="app">
    <header>
      <div class="title">
        <BackLink class="back" />
        <h1>traductor</h1>
      </div>
      <!-- Aquí pinta WhisperTranslator los selectores de idioma (con un portal de React). -->
      <div id="tr-controls"></div>
      <p id="status" class="status" data-state="paused">en espera</p>
    </header>
    <div id="progress" class="progress" aria-hidden="true" hidden></div>

    <main>
      <WhisperTranslator client:only="react" />
    </main>
  </div>
</Directo>

<style>
  .app {
    display: grid;
    grid-template-rows: auto auto 1fr;
    min-height: 100dvh;
    padding: 1rem clamp(1rem, 3vw, 2rem) 1.5rem;
    font-size: 0.8125rem;
  }

  /* Tres columnas: los lados ocupan lo mismo, así los selectores quedan en el centro exacto. */
  header {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 0.75rem 1.25rem;
  }

  .title {
    display: flex;
    align-items: center;
    gap: 0.5rem 1.25rem;
  }

  /* En pantallas estrechas, los selectores bajan a su propia fila, centrados. */
  @media (max-width: 760px) {
    header {
      grid-template-columns: 1fr auto;
    }

    #tr-controls {
      grid-column: 1 / -1;
      grid-row: 2;
      justify-self: center;
    }
  }

  .back {
    color: var(--muted);
    text-decoration: none;
    white-space: nowrap;
  }

  .back:hover {
    color: var(--fg);
  }

  h1 {
    margin: 0;
    font-family: var(--font-pixel);
    font-weight: 500;
    font-size: 1.5rem;
    letter-spacing: -0.01em;
  }

  .status {
    justify-self: end;
    margin: 0;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--muted);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-size: 0.6875rem;
  }

  .status::before {
    content: '';
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: currentColor;
  }

  .status[data-state='loading'] {
    color: var(--yellow);
  }

  .status[data-state='loading']::before,
  .status[data-state='playing']::before {
    animation: pulse 0.8s ease-in-out infinite alternate;
  }

  .status[data-state='playing'] {
    color: var(--red);
  }

  .status[data-state='error'] {
    color: var(--red);
  }

  .progress {
    --p: 0;
    height: 2px;
    margin-top: 0.75rem;
    background:
      linear-gradient(var(--yellow), var(--yellow)) no-repeat 0 0 / calc(var(--p) * 100%) 100%,
      #1a1a1a;
    transition: background-size 0.2s;
  }

  .progress[hidden] {
    display: block;
    visibility: hidden;
  }

  main {
    display: grid;
    align-content: center;
    width: min(100%, 64rem);
    margin-inline: auto;
    padding-block: 1.5rem;
  }

  @keyframes pulse {
    from {
      opacity: 1;
    }
    to {
      opacity: 0.3;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .status::before {
      animation: none !important;
    }
  }
</style>
