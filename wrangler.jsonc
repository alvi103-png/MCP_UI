{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "upskilling-mwc-taller",
  "account_id": "599228840df452ef6b4df93a2b67c0ee",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },

  // Variables públicas (no secretas). Los secretos van con `wrangler secret put`.
  "vars": {
    // Modelos de OpenAI que pueden usar los asistentes (el primero es el modelo por defecto)
    "OPENAI_MODELS": "gpt-6-luna",
    "JEV_DEFAULT_MODEL": "jev-latest"
  },

  // Límite por IP a las APIs del taller. Toda la sala sale a internet por la misma Wi-Fi (misma IP),
  // así que el límite es para la sala entera, no por persona: 300 peticiones cada 10 s (~1.800/min,
  // pensado para más de 100 personas, unas 150 con margen). Ventanas de 10 s: si alguien deja un bucle, el bloqueo dura poco.
  // Si cambias `period`, actualiza RATE_LIMIT_PERIOD en src/lib/proxy.ts.
  "ratelimits": [
    {
      "name": "RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 300, "period": 10 }
    }
  ]
}
